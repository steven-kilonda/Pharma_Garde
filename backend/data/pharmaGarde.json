  "faq": [
    {
      "id": "1",
      "categorie": "Comment ça marche",
      "question": "Comment savoir quelle pharmacie est de garde ce soir ?",
      "reponse": "Le planning est publié chaque semaine par l'organisation des pharmaciens de Pointe-Noire. L'onglet « Pharmacies » affiche les officines de garde de la semaine en cours ; les badges « De garde · 24h/24 » ou « De garde · sur appel » indiquent le niveau de service. En cas de doute, appelez toujours avant de vous déplacer."
    },
    {
      "id": "2",
      "categorie": "Comment ça marche",
      "question": "Faut-il créer un compte pour utiliser le site ?",
      "reponse": "Non. PharmaGarde est un service libre et gratuit : aucune inscription, aucune donnée personnelle. Votre position n'est utilisée que localement, dans votre navigateur, pour trier les pharmacies par distance."
    },
    {
      "id": "3",
      "categorie": "Comment ça marche",
      "question": "Les horaires affichés sont-ils fiables ?",
      "reponse": "Les plannings de garde sont vérifiés par téléphone avant publication — la date de vérification est affichée sur chaque fiche. Les horaires d'ouverture habituels restent indicatifs : en cas de doute, appelez l'officine."
    },
    {
      "id": "4",
      "categorie": "Pharmacies de garde",
      "question": "Le service de garde est-il payant ?",
      "reponse": "Non. La garde est une obligation réglementaire : l'accès à l'officine et la délivrance des médicaments suivent les prix officiels. Aucun frais supplémentaire n'est lié à la garde elle-même."
    },
    {
      "id": "5",
      "categorie": "Pharmacies de garde",
      "question": "Que faire si la pharmacie de garde est fermée ?",
      "reponse": "Vérifiez d'abord le badge sur sa fiche : de garde 24h/24, ouverte en journée, ou sur appel (à appeler avant de se déplacer). Si une officine listée est injoignable ou fermée, signalez-le depuis la page Urgences. En urgence vitale, composez le 118 (sapeurs-pompiers)."
    },
    {
      "id": "6",
      "categorie": "Pharmacies de garde",
      "question": "Pourquoi certaines pharmacies n'apparaissent pas ?",
      "reponse": "Seules les officines de la liste hebdomadaire officielle dont le numéro public a pu être vérifié sont publiées. Celles écartées faute de numéro joignable ne peuvent pas être affichées."
    },
    {
      "id": "7",
      "categorie": "Médicaments & prix",
      "question": "Puis-je acheter mes médicaments sur le site ?",
      "reponse": "Non. PharmaGarde n'est pas une pharmacie en ligne : il vous oriente vers l'officine qui dispose du produit. L'achat se fait toujours sur place, avec l'avis d'un pharmacien."
    },
    {
      "id": "8",
      "categorie": "Médicaments & prix",
      "question": "Les prix affichés sont-ils ceux que je paierai ?",
      "reponse": "Les prix indicatifs en FCFA sont donnés à titre informatif et peuvent varier selon les officines et les lots. Seul le prix affiché en pharmacie fait foi."
    },
    {
      "id": "9",
      "categorie": "Géolocalisation & carte",
      "question": "Ma position est-elle enregistrée ?",
      "reponse": "Non. La géolocalisation est demandée uniquement pour calculer des distances et reste dans votre navigateur. Rien n'est transmis à aucun serveur."
    },
    {
      "id": "10",
      "categorie": "Géolocalisation & carte",
      "question": "Pourquoi la distance indiquée est-elle approximative ?",
      "reponse": "Les distances sont calculées « à vol d'oiseau » entre votre position et l'officine. Le temps de trajet réel dépend de la circulation et de l'état des routes."
    },
    {
      "id": "11",
      "categorie": "Pour les pharmacies",
      "question": "Je suis pharmacien : comment apparaître dans le planning ?",
      "reponse": "Le planning hebdomadaire est établi par votre organisation professionnelle. Une fois la liste publiée, vérifiez vos horaires et coordonnées par téléphone : la fiche est mise à jour après vérification."
    },
    {
      "id": "12",
      "categorie": "Pour les pharmacies",
      "question": "Comment corriger une information sur ma fiche ?",
      "reponse": "Utilisez le formulaire de signalement en page Urgences (type « Horaires ou informations erronées »). Les corrections sont appliquées à la prochaine mise à jour des données."
